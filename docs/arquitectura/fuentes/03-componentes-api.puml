@startuml
!include <C4/C4_Component>
!include estilo.iuml
title Diagrama de componentes · API gestion-guias (NestJS, monolito modular)
LAYOUT_LEFT_RIGHT()
Container(spa, "Aplicación web", "Angular 21", "Llama a /api/* con el token del usuario")
Container_Boundary(api, "API gestion-guias") {
  Component(auth, "Autenticación", "AuthController · KeycloakAuthGuard · KeycloakRolesGuard · SessionRevocationService", "Login, renovación, cierre de sesión y cambio de contraseña temporal. Guards globales: token JWT válido y rol permitido en 80 de las 85 rutas.")
  Component(users, "Usuarios, roles y permisos (HE-01)", "UsersController · RolePermissionsController · KeycloakAdminService", "Registro, edición, cambio de rol, desactivación, reactivación y restablecimiento de contraseña; matriz de permisos.")
  Component(prog, "Programa académico (HE-02)", "Programs · CurricularModules · Competencies", "Programa, 7 módulos y sus competencias, con historial de revisiones de cada competencia.")
  Component(guias, "Guías base (HE-03)", "AcademicController · AcademicService · GuideDocumentExportService", "Estructura de campos, borrador, publicación, materiales de apoyo, asignación de docentes y exportación a PDF y Word.")
  Component(esp, "Espacio docente (HE-04)", "TeacherSpaceController · TeachersController", "Guías asignadas, versiones propias por grupo, guardado por campo, complemento del docente autorizado y exportación.")
  Component(sug, "Sugerencias (HE-05)", "SuggestionInbox · Approval · Rejection · TeacherSuggestions · SuggestionSettings", "Envío, bandeja de coordinación, aprobación (nueva versión de la guía), rechazo con motivo y plazos.")
  Component(notif, "Notificaciones", "NotificationsController · NotificationsService", "Avisos en la campana: sugerencias nuevas, aprobadas, rechazadas o por vencer.")
  Component(bus, "Búsqueda (HE-06)", "GuideSearchController", "Búsqueda por texto y filtros por módulo, competencia, estado y autor.")
  Component(hist, "Historial de versiones (HE-07)", "GuideHistoryController", "Versiones de cada guía base, eventos y consulta de versiones anteriores.")
  Component(aud, "Auditoría (HE-08)", "AuditActionsController · interceptor de auditoría", "Registra cada acción con usuario, fecha, IP, módulo y resultado; filtros y exportación CSV.")
  Component(conf, "Configuración (HE-09)", "SuggestionSettings · periodos de bloqueo", "Plazo de respuesta de sugerencias y periodos en que no se editan guías.")
  Component(trans, "Transversal", "ErrorLoggingFilter · validación · migraciones TypeORM", "Errores con registro estructurado, validación de datos de entrada y migraciones del esquema.")
}
ContainerDb(db, "PostgreSQL 16", "gestion_guias", "16 tablas")
Container(kc, "Keycloak 26.3", "realm system-plus", "Cuentas y roles")
Rel(spa, auth, "Inicia sesión", "POST /auth/login")
Rel(spa, users, "Usa")
Rel(spa, guias, "Usa")
Rel(spa, esp, "Usa")
Rel(spa, sug, "Usa")
Rel(auth, kc, "Valida credenciales y firmas", "OIDC · JWKS")
Rel(users, kc, "Administra cuentas y roles", "Admin REST")
Rel(sug, guias, "Al aprobar, publica la nueva versión")
Rel(sug, notif, "Genera avisos")
Rel(esp, guias, "Copia la guía base")
Rel(guias, hist, "Registra versiones")
Rel(guias, prog, "Valida módulo y competencia")
Rel(aud, db, "Guarda eventos")
Rel(guias, db, "Lee y escribe")
Rel(prog, db, "Lee y escribe")
Rel(sug, db, "Lee y escribe")
Rel(esp, db, "Lee y escribe")
@enduml
