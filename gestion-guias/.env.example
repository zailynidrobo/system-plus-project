# Copia este archivo como .env (desarrollo) y como .env.test (pruebas e2e).

# Keycloak (coincide con el realm keycloak/system-plus-realm.json)
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/system-plus
KEYCLOAK_AUDIENCE=system-plus-api

# Client público con el que la API valida el formulario de inicio de sesión (opcional, este es el valor por defecto).
# KEYCLOAK_FRONT_CLIENT_ID=system-plus-front

# Keycloak: cuenta de servicio con la que la API administra los usuarios (HE-01).
# Es un client confidencial del realm con "Service accounts roles" activado; ver el README.
KEYCLOAK_ADMIN_CLIENT_ID=system-plus-api
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Orígenes del front permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:4200

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gestion_guias
# true solo en desarrollo/pruebas: crea las tablas a partir de las entidades.
DB_SYNCHRONIZE=true

# Instalación local de LibreOffice para exportar PDF (descomenta y ajusta si no está en PATH).
# En Windows usa soffice.com para esperar a que termine la conversión.
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.com

# En .env.test usa una base distinta terminada en _test (las pruebas e2e la reinician):
# DB_NAME=gestion_guias_test
