# Copia este archivo como .env (desarrollo) y como .env.test (pruebas e2e).

# Keycloak
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/system-plus
KEYCLOAK_AUDIENCE=system-plus-api

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gestion_guias
# true solo en desarrollo/pruebas: crea las tablas a partir de las entidades.
DB_SYNCHRONIZE=true

# En .env.test usa una base distinta terminada en _test (las pruebas e2e la reinician):
# DB_NAME=gestion_guias_test
