{
  "realm": "system-plus",
  "enabled": true,
  "displayName": "System Plus",
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administración de usuarios"
      },
      {
        "name": "coordinador",
        "description": "Gestión académica y de guías"
      },
      {
        "name": "docente",
        "description": "Consulta y personalización de guías"
      },
      {
        "name": "docente_autorizado",
        "description": "Docente autorizado"
      }
    ]
  },
  "clients": [
    {
      "clientId": "system-plus-api",
      "name": "System Plus API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "system-plus-client",
      "name": "System Plus local/Postman client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "protocolMappers": [
        {
          "name": "system-plus-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "system-plus-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "system-plus-user-admin",
      "name": "System Plus user administration service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ]
}
