            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": [\n    {\n      \"key\": \"objective\",\n      \"label\": \"Objetivo de aprendizaje\",\n      \"type\": \"textarea\",\n      \"required\": true,\n      \"section\": \"Planeación\"\n    },\n    {\n      \"key\": \"duration\",\n      \"label\": \"Duración en horas\",\n      \"type\": \"number\",\n      \"required\": false,\n      \"section\": \"Planeación\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
