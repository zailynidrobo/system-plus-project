    {
      "name": "04 - Usuarios: registro y consulta",
      "description": "Registra y consulta usuarios de aplicación con el token del coordinador (coordinatorToken). Ejecuta el registro antes de las solicitudes que usan userId.",
      "item": [
        {
          "name": "Registrar usuario",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newUserEmail', 'usuario.postman.' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Usuario registrado sin exponer contraseña', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.email).to.eql(pm.collectionVariables.get('newUserEmail'));",
                  "  pm.expect(body.isActive).to.eql(true);",
                  "  pm.expect(body).not.to.have.property('password');",
                  "  pm.collectionVariables.set('userId', body.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{newUserName}}\",\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"{{newUserPassword}}\",\n  \"role\": \"{{newUserRole}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Listar usuarios",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lista usuarios y excluye contraseñas', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const users = pm.response.json();",
                  "  pm.expect(users).to.be.an('array');",
                  "  pm.expect(users.some((user) => user.id === pm.collectionVariables.get('userId'))).to.eql(true);",
                  "  users.forEach((user) => pm.expect(user).not.to.have.property('password'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              }
            ],
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Consultar usuario por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Detalle de usuario correcto y sin contraseña', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const user = pm.response.json();",
                  "  pm.expect(user.id).to.eql(pm.collectionVariables.get('userId'));",
                  "  pm.expect(user).not.to.have.property('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              }
            ],
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        }
      ]
    },
