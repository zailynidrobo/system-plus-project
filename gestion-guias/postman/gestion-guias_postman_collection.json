  "item": [
    {
      "name": "00 - Autenticación Keycloak",
      "description": "Configura coordinatorUsername/coordinatorPassword (rol coordinador) y teacherUsername/teacherPassword (rol docente). El token del coordinador (coordinatorToken) se usa en la gestión de módulos, guías y usuarios (registro, consulta, edición, cambio de rol y desactivación); teacherToken se usa en las versiones personalizadas y en la prueba 403.",
      "item": [
        {
          "name": "Obtener token coordinador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Keycloak devuelve un access_token', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('coordinatorToken', body.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "username",
                  "value": "{{coordinatorUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{coordinatorPassword}}"
                },
                {
                  "key": "scope",
                  "value": "openid"
                }
              ]
            },
            "url": "{{keycloakTokenUrl}}"
          }
        },
        {
          "name": "Obtener token docente y guardar sub",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Keycloak devuelve el token del docente', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('teacherToken', body.access_token);",
                  "  const payload = JSON.parse(atob(body.access_token.split('.')[1]));",
                  "  pm.expect(payload.sub).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('teacherSub', payload.sub);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "username",
                  "value": "{{teacherUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{teacherPassword}}"
                },
                {
                  "key": "scope",
                  "value": "openid"
                }
              ]
            },
            "url": "{{keycloakTokenUrl}}"
          }
        }
      ]
    },
    {
      "name": "01 - Configuración de prueba (coordinador)",
      "description": "Ejecutar en orden. Crea un módulo de prueba, configura los campos de guía base y docente, genera una guía borrador, la edita y la publica, y asigna el módulo al usuario docente.",
      "item": [
        {
          "name": "Obtener programa académico (HE-02)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Programa disponible', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  const programs = Array.isArray(body) ? body : (body.items || []);",
                  "  pm.expect(programs.length).to.be.above(0);",
                  "  pm.collectionVariables.set('programId', programs[0].id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              }
            ],
            "url": "{{baseUrl}}/programs"
          }
        },
        {
          "name": "Crear módulo de prueba (HE-02)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Módulo creado', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('moduleId', body.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Módulo Postman Sesiones\",\n  \"description\": \"Módulo temporal para verificar edición y versiones de guías\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/programs/{{programId}}/modules"
          }
        },
        {
          "name": "Asociar competencia al módulo (HE-02)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Competencia creada', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('competencyId', body.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
