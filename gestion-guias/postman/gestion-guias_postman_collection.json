        {
          "name": "Adjuntar material de apoyo PDF o DOCX",
          "description": "Como coordinador, selecciona un PDF o DOCX en el campo file. El archivo se almacena sin edición en PostgreSQL (máximo 10 MB).",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Material de apoyo almacenado', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.guideId).to.eql(pm.collectionVariables.get('guideId'));",
                  "  pm.collectionVariables.set('supportMaterialId', body.id);",
