          "name": "Configurar campos de versión personalizada docente",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": [\n    {\n      \"key\": \"classroomNotes\",\n      \"label\": \"Notas para mi clase\",\n      \"type\": \"textarea\",\n      \"required\": false,\n      \"section\": \"Adaptación docente\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/academic/modules/{{moduleId}}/teacher-guide-fields"
          }
        },
        {
          "name": "Crear guía borrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Guía borrador creada', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.status).to.eql('draft');",
                  "  pm.collectionVariables.set('guideId', body.id);",
