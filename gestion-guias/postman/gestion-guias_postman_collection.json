            "url": "{{baseUrl}}/academic/guides/{{guideId}}/support-materials"
          }
        },
        {
          "name": "Editar guía borrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Guía borrador editada', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.title).to.eql('Guía Postman editada');",
                  "  pm.expect(body.content.objective).to.eql('Objetivo actualizado desde Postman');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Guía Postman editada\",\n  \"content\": {\n    \"objective\": \"Objetivo actualizado desde Postman\",\n    \"duration\": 3\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/academic/guides/{{guideId}}"
          }
        },
        {
