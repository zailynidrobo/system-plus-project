              "mode": "raw",
              "raw": "{\n  \"moduleId\": \"{{moduleId}}\",\n  \"title\": \"Guía de prueba Postman\",\n  \"content\": {\n    \"objective\": \"Comprender el tema mediante una actividad práctica\",\n    \"duration\": 2\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/academic/guides"
          }
