    {
      "name": "02 - Consulta y exportación de guía",
      "description": "Se puede ejecutar como coordinador o docente asignado (token docente para ver solamente guías publicadas del módulo asignado).",
      "item": [
        {
          "name": "Listar guías del módulo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Listado de guías OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "  pm.expect(pm.response.json().some((guide) => guide.id === pm.collectionVariables.get('guideId'))).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              }
            ],
            "url": "{{baseUrl}}/academic/guides?moduleId={{moduleId}}"
          }
        },
        {
          "name": "Consultar guía",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Detalle de guía OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('guideId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              }
            ],
            "url": "{{baseUrl}}/academic/guides/{{guideId}}"
          }
        },
        {
          "name": "Listar material de apoyo (docente asignado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lista los materiales sin exponer los archivos binarios', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const materials = pm.response.json();",
                  "  pm.expect(materials).to.be.an('array');",
                  "  pm.expect(materials.some((item) => item.id === pm.collectionVariables.get('supportMaterialId'))).to.eql(true);",
                  "  materials.forEach((item) => pm.expect(item).not.to.have.property('data'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacherToken}}"
              }
