# El script instalar-servidor copia este archivo como .env y reemplaza cada "se-genera-al-instalar"
# por una clave aleatoria. Usted solo llena los datos del primer administrador (abajo).
# El archivo .env no se sube a GitHub ni se comparte: guárdelo como respaldo en un lugar seguro.

VERSION=1.0

# Puerto por el que entran los equipos de la sala (http://IP-del-servidor)
PUERTO_WEB=80

# PostgreSQL (lo usan la API y Keycloak)
DB_USER=systemplus
DB_PASSWORD=se-genera-al-instalar
DB_NAME=gestion_guias

# Administrador de la consola de Keycloak (http://localhost:8080 desde el servidor)
KEYCLOAK_ADMIN_USER=admin-keycloak
KEYCLOAK_ADMIN_PASSWORD=se-genera-al-instalar

# Secreto con el que la API se identifica ante Keycloak. Se pone en el realm al instalar.
# Si lo cambian después en la consola de Keycloak, cámbienlo también aquí.
KEYCLOAK_API_SECRET=se-genera-al-instalar

# Primer administrador de System Plus. Llene correo, nombre y apellido (sin comillas).
# Al entrar por primera vez el sistema le pide cambiar la contraseña temporal.
ADMIN_CORREO=
ADMIN_NOMBRE=
ADMIN_APELLIDO=
ADMIN_CLAVE_TEMPORAL=se-genera-al-instalar

# Las pantallas y la API comparten dirección (Nginx), así que esto casi nunca hace falta cambiarlo.
CORS_ORIGIN=http://192.168.50.10,http://localhost
