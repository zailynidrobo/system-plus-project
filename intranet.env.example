# Copia este archivo como .env (en la misma carpeta que docker-compose.yml) y cambia las contraseñas.
# El archivo .env no se sube a GitHub.

VERSION=1.0

# Puerto por el que entran los equipos de la sala (http://IP-del-servidor)
PUERTO_WEB=80

# PostgreSQL (lo usan la API y Keycloak)
DB_USER=systemplus
DB_PASSWORD=cambiar-esta-clave
DB_NAME=gestion_guias

# Administrador de la consola de Keycloak (http://localhost:8080 desde el servidor)
KEYCLOAK_ADMIN_USER=admin-keycloak
KEYCLOAK_ADMIN_PASSWORD=cambiar-esta-clave

# Debe ser igual al "secret" del client system-plus-api en keycloak/system-plus-realm.json.
# Si lo cambian en Keycloak, cámbienlo también aquí.
KEYCLOAK_API_SECRET=dev-secret-system-plus-api

# Las pantallas y la API comparten dirección (Nginx), así que esto casi nunca hace falta cambiarlo.
CORS_ORIGIN=http://192.168.50.10,http://localhost
