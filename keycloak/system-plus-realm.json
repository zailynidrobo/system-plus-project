{
  "realm": "system-plus",
  "displayName": "System Plus",
  "enabled": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrador: gestiona usuarios y roles"
      },
      {
        "name": "coordinador",
        "description": "Coordinador académico"
      },
      {
        "name": "docente",
        "description": "Docente"
      },
      {
        "name": "docente_autorizado",
        "description": "Docente autorizado"
      }
    ]
  },
  "clients": [
    {
      "clientId": "system-plus-front",
      "name": "System Plus (front)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:4200",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience-system-plus-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "system-plus-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "system-plus-api",
      "name": "System Plus (API)",
      "description": "Cuenta de servicio con la que el backend administra los usuarios (HE-01).",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-secret-system-plus-api",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "service-account-system-plus-api",
      "enabled": true,
      "serviceAccountClientId": "system-plus-api",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    },
    {
      "username": "admin@example.com",
      "email": "admin@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "admin",
      "lastName": "1",
      "credentials": [
        {
          "type": "password",
          "value": "12345678",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "coordinador@example.com",
      "email": "coordinador@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "coordinador",
      "lastName": "1",
      "credentials": [
        {
          "type": "password",
          "value": "12345678",
          "temporary": false
        }
      ],
      "realmRoles": [
        "coordinador"
      ]
    },
    {
      "username": "docente@example.com",
      "email": "docente@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "docente",
      "lastName": "1",
      "credentials": [
        {
          "type": "password",
          "value": "12345678",
          "temporary": false
        }
      ],
      "realmRoles": [
        "docente"
      ]
    },
    {
      "username": "autorizado@example.com",
      "email": "autorizado@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "autorizado",
      "lastName": "1",
      "credentials": [
        {
          "type": "password",
          "value": "12345678",
          "temporary": false
        }
      ],
      "realmRoles": [
        "docente_autorizado"
      ]
    }
  ]
}
